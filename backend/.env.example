# App
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=my_cast
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis & Queue (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URI=amqp://guest:guest@localhost:5672

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key

# Storage nodes (JSON array)
STORAGE_NODES=[{"name":"local-minio","endpoint":"http://localhost:9000","region":"auto","accessKeyId":"minioadmin","secretAccessKey":"minioadmin","publicUrl":"http://localhost:9000","bucket":"my-cast","quota":0}]

# env, db, both
STORAGE_MODE=env

# Mail (SMTP defaults)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-character-google-app-password
MAIL_FROM="Cinema Management" <your-gmail-address@gmail.com>

# Email Verification
EMAIL_VERIFICATION_TTL=900
