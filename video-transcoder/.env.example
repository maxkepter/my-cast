PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=my_cast_transcoder
DB_SYNCHRONIZE=true
DB_LOGGING=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_URI=amqp://guest:guest@localhost:5672
# Limit concurrent transcode jobs per consumer. For long videos, ops should also raise RabbitMQ consumer_timeout (default 30 min) so unacked messages do not close the channel.
RABBITMQ_PREFETCH=1

BACKEND_URL=http://localhost:3000
BACKEND_TIMEOUT=30000
BACKEND_STORAGE_PREFIX=/api/v1/storage
BACKEND_DOWNLOAD_TIMEOUT=0

LOCAL_STORAGE_BASE_DIR=
